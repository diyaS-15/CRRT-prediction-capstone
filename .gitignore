# --- HIPAA / PHI: NEVER commit raw data ---
# Root-anchored (/data/*, not **/data/**) on purpose: an unanchored **/data/
# rule here previously silently gitignored src/crrt/data/ (a Python package,
# not a data-storage folder) — nothing in it could ever be committed. Only
# the actual data-storage directory at the repo root needs this protection.
# .dvc pointer files (small YAML files holding a content hash, not the data
# itself) are explicitly un-ignored so the synthetic dataset can be tracked
# with DVC. Any *real* PHI data must never be `dvc add`-ed here.
/data/*
!/data/*.dvc
!/data/.gitignore

venv/
.venv

# common sensitive data file types anywhere
*.csv
*.xlsx
*.xls
*.parquet
*.feather
*.sav
*.dta
*.db
*.sqlite
*.sqlite3

# OS / editor noise
.DS_Store
.vscode/
__pycache__/
*.pyc
.ipynb_checkpoints/results/
results/

# packaging / test artifacts
*.egg-info/
.pytest_cache/
build/

# CatBoost training logs
catboost_info/

# MLflow local tracking store + artifact store (each machine/CI run gets its
# own; a shared setup would point MLFLOW_TRACKING_URI at a real server)
mlflow.db
mlruns/
mlartifacts/
